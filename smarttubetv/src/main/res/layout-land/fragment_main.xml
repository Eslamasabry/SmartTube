<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile landscape layout optimized for wider screens -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Optional side navigation panel -->
    <LinearLayout
        android:id="@+id/mobile_side_panel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorPrimary"
        android:elevation="4dp"
        android:visibility="gone">

        <!-- Side panel content can be added here -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/mobile_toolbar_height"
            android:text="@string/app_name"
            android:textSize="@dimen/mobile_title_text_size"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/mobile_content_margin"
            android:paddingEnd="@dimen/mobile_content_margin" />

    </LinearLayout>

    <!-- Main content area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Mobile-friendly toolbar -->
        <LinearLayout
            android:id="@+id/mobile_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mobile_toolbar_height"
            android:orientation="horizontal"
            android:background="?android:attr/colorPrimary"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/mobile_content_margin"
            android:paddingEnd="@dimen/mobile_content_margin">

            <!-- Menu button -->
            <ImageButton
                android:id="@+id/mobile_menu_button"
                android:layout_width="@dimen/mobile_touch_target_size"
                android:layout_height="@dimen/mobile_touch_target_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/menu_button"
                android:scaleType="centerInside" />

            <!-- App title -->
            <TextView
                android:id="@+id/mobile_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/mobile_content_margin"
                android:text="@string/app_name"
                android:textSize="@dimen/mobile_title_text_size"
                android:textColor="?android:attr/textColorPrimary"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Search button -->
            <ImageButton
                android:id="@+id/mobile_search_button"
                android:layout_width="@dimen/mobile_touch_target_size"
                android:layout_height="@dimen/mobile_touch_target_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/action_search"
                android:contentDescription="@string/action_search"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- Content fragment -->
        <fragment
            android:id="@+id/main_frame"
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.browse.BrowseFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/mobile_edge_margin"
            android:layout_marginEnd="@dimen/mobile_edge_margin" />

    </LinearLayout>

</LinearLayout>