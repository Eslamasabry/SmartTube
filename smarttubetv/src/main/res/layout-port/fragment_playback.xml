<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile portrait playback layout with controls at bottom -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Video surface area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/black">
        
        <fragment
            android:id="@+id/playback_controls_fragment"
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.playback.PlaybackFragment"
            android:tag="@string/playback_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
    </FrameLayout>

    <!-- Mobile controls area -->
    <LinearLayout
        android:id="@+id/mobile_playback_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/black"
        android:paddingTop="@dimen/mobile_playback_controls_margin"
        android:paddingBottom="@dimen/mobile_playback_controls_margin"
        android:paddingStart="@dimen/mobile_content_margin"
        android:paddingEnd="@dimen/mobile_content_margin">

        <!-- Progress bar -->
        <SeekBar
            android:id="@+id/mobile_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mobile_playback_progress_height"
            android:layout_marginBottom="@dimen/mobile_content_margin" />

        <!-- Control buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Previous button -->
            <ImageButton
                android:id="@+id/mobile_previous_button"
                android:layout_width="@dimen/mobile_playback_button_size"
                android:layout_height="@dimen/mobile_playback_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_previous"
                android:contentDescription="@string/previous"
                android:scaleType="centerInside"
                android:layout_marginEnd="@dimen/mobile_button_margin" />

            <!-- Rewind button -->
            <ImageButton
                android:id="@+id/mobile_rewind_button"
                android:layout_width="@dimen/mobile_playback_button_size"
                android:layout_height="@dimen/mobile_playback_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_fast_rewind"
                android:contentDescription="@string/rewind"
                android:scaleType="centerInside"
                android:layout_marginEnd="@dimen/mobile_button_margin" />

            <!-- Play/Pause button -->
            <ImageButton
                android:id="@+id/mobile_play_pause_button"
                android:layout_width="@dimen/mobile_playback_button_size"
                android:layout_height="@dimen/mobile_playback_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play_arrow"
                android:contentDescription="@string/play_pause"
                android:scaleType="centerInside"
                android:layout_marginEnd="@dimen/mobile_button_margin" />

            <!-- Fast forward button -->
            <ImageButton
                android:id="@+id/mobile_fast_forward_button"
                android:layout_width="@dimen/mobile_playback_button_size"
                android:layout_height="@dimen/mobile_playback_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_fast_forward"
                android:contentDescription="@string/fast_forward"
                android:scaleType="centerInside"
                android:layout_marginEnd="@dimen/mobile_button_margin" />

            <!-- Next button -->
            <ImageButton
                android:id="@+id/mobile_next_button"
                android:layout_width="@dimen/mobile_playback_button_size"
                android:layout_height="@dimen/mobile_playback_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_next"
                android:contentDescription="@string/next"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- Time and additional controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/mobile_button_margin">

            <!-- Current time -->
            <TextView
                android:id="@+id/mobile_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="@dimen/mobile_subtitle_text_size" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Fullscreen button -->
            <ImageButton
                android:id="@+id/mobile_fullscreen_button"
                android:layout_width="@dimen/mobile_touch_target_size"
                android:layout_height="@dimen/mobile_touch_target_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_fullscreen"
                android:contentDescription="@string/fullscreen"
                android:scaleType="centerInside"
                android:layout_marginEnd="@dimen/mobile_button_margin" />

            <!-- Total time -->
            <TextView
                android:id="@+id/mobile_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="@dimen/mobile_subtitle_text_size" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>